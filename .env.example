# Copy to .env (gitignored). Anything set here overrides config.json.
# The chat talks to ANY OpenAI-compatible /v1/chat/completions endpoint.

# A local model (pick one):
# CC_CHAT_BASE_URL=http://localhost:11434/v1     # Ollama
# CC_CHAT_BASE_URL=http://localhost:8000/v1      # vLLM / SGLang
# CC_CHAT_BASE_URL=http://localhost:8080/v1      # llama.cpp server
# CC_CHAT_BASE_URL=http://localhost:1234/v1      # LM Studio
# CC_CHAT_MODEL=llama3.1:8b

# Or an agent that exposes an OpenAI-compatible API (for example a Hermes profile's API server):
# CC_CHAT_BASE_URL=http://127.0.0.1:8643/v1
# CC_CHAT_MODEL=my-agent
# CC_CHAT_API_KEY=paste-the-agent-key-here

# Optional
# CC_CHAT_NAME=Jarvis
# CC_CHAT_SYSTEM_PROMPT=You are the assistant for my home lab.
# CC_PORT=8895
# CC_BIND=127.0.0.1
# CC_READ_ONLY=true
# CC_CONFIG=/path/to/another/config.json
